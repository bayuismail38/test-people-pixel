# === STAGE 1: Build Stage ===
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY tsconfig.json ./
COPY src/ ./src/
RUN npm run build

# === STAGE 2: Run Stage ===
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
# ONLY install production dependencies to keep it light
RUN npm install --only=production
COPY --from=builder /app/dist ./dist

# Render assigns a random port dynamically, but your local fallback can be 3000
EXPOSE 3000
CMD ["node", "dist/index.js"]
